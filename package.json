{
  "name": "tracklab-lite",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/core.test.js .test-build/tests/patterns.test.js",
    "test:browser": "npm run build && playwright test"
  },
  "dependencies": { "three": "0.187.0" },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "@types/three": "^0.185.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "engines": { "node": ">=20.19.0" }
}
